# Supabase › Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Solo servidor (NUNCA con prefijo NEXT_PUBLIC_): lo usan las páginas públicas por token.
SUPABASE_SERVICE_ROLE_KEY=

# Dominio público para los links de WhatsApp (en local se detecta solo).
NEXT_PUBLIC_SITE_URL=

# Avisos automáticos por correo (Resend). Opcional: sin estas, no se manda ningún correo.
RESEND_API_KEY=
AVISOS_REMITENTE="Black Key <avisos@tudominio.mx>"
# Secreto para el envío diario (Vercel Cron lo manda solo si está definido)
CRON_SECRET=

# Cobro de la suscripción (Stripe). Opcional.
STRIPE_SECRET_KEY=
STRIPE_PRICE_INICIAL=
STRIPE_PRICE_PROFESIONAL=
STRIPE_PRICE_AGENCIA=
STRIPE_WEBHOOK_SECRET=

# WhatsApp Business (Cloud API de Meta). Opcional.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Facturación CFDI (Facturapi). Llave secreta de USUARIO (sk_user_…). FACTURAPI_MODO=test para pruebas.
FACTURAPI_KEY=
FACTURAPI_MODO=

# Datos del responsable para /privacidad y /terminos (obligatorio antes de cobrar)
LEGAL_RESPONSABLE="Nombre o razón social"
LEGAL_DOMICILIO="Calle, número, colonia, CP, Querétaro, México"
LEGAL_CORREO=privacidad@tudominio.mx

# Correos (separados por coma) de quienes revisan las solicitudes a la red de proveedores (/red/admin).
PLATAFORMA_ADMINS=

# Notificaciones push (app instalable). Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# INPC del INEGI para aumentos de renta (token gratis en inegi.org.mx › API de Indicadores)
INEGI_TOKEN=
# Cobro de rentas con Stripe Connect: secreto del webhook de cuentas conectadas y comisión opcional (%)
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_COMISION_PCT=
